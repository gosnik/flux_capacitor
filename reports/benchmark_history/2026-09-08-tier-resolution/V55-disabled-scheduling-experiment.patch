+void early_straight_physics_reaches_the_next_global_epoch() {
+  Board board;
+  board.source_revision = "early-straight-feedback-crossing";
+  board.outline = rectangle(0.0, 0.0, 30.0, 30.0);
+  board.layers = {{LayerId{"F.Cu"}, "F.Cu", LayerKind::copper, 0}};
+  board.nets = {{NetId{"a"}, "A", 2}, {NetId{"b"}, "B", 1}};
+  const auto terminal = [](std::string id, NetId net, Point position) {
+    Footprint footprint;
+    footprint.id = ObjectId{id};
+    footprint.reference = id;
+    footprint.position = position;
+    footprint.courtyard = local_rectangle(0.4, 0.4);
+    footprint.pads = {{ObjectId{id + "-pad"}, std::move(net), Point{}, {LayerId{"F.Cu"}}}};
+    return footprint;
+  };
+  board.footprints = {terminal("A1", NetId{"a"}, mm(10.0, 10.0)),
+                      terminal("A2", NetId{"a"}, mm(20.0, 20.0)),
+                      terminal("B1", NetId{"b"}, mm(20.0, 10.0)),
+                      terminal("B2", NetId{"b"}, mm(10.0, 20.0))};
+  flux::RoutingPlannerConfig config;
+  config.full_strength_first_pass = false;
+  config.global.grid_pitch = Nanometres::from_mm(10.0);
+  config.global.max_iterations = 2U;
+  config.global.max_pin_escape_grid_radius = 0U;
+  config.global.max_pin_access_nodes_per_terminal = 1U;
+  config.global.use_free_space_corridors = false;
+  config.global.allow_crossing_safe_diagonal_grid_edges = true;
+  config.global.present_congestion_cost = 0U;
+  config.global.history_congestion_cost = 0U;
+  config.max_routability_feedback_retries = 1U;
+  config.regional.max_bundle_search_states = 32U;
+  config.regional.max_physical_scope_retries = 0U;
+  const auto deferred = flux::plan_routes(board, config);
+  require(deferred.feedback_probes.size() == 2U &&
+              std::none_of(deferred.feedback_probes.front().candidates.begin(),
+                           deferred.feedback_probes.front().candidates.end(),
+                           [](const auto& candidate) { return candidate.regional_consulted; }),
+          "control must defer straight copper beyond the first global epoch");
+  config.early_straight_feedback = true;
+  const auto early = flux::plan_routes(board, config);
+  require(!early.complete() && early.feedback_probes.size() == 2U &&
+              early.cumulative_global_iterations == 2U,
+          "early physical failure must preserve the caller's global retry budget");
+  const auto& first = early.feedback_probes.front();
+  require(first.candidates.size() == 1U && first.candidates.front().regional_consulted &&
+              first.candidates.front().regional_straight_realization_enabled &&
+              !first.candidates.front().regional_spline_realization_enabled &&
+              first.candidates.front().regional_diagnoses > 0U &&
+              first.history_pressure_after_regional > first.history_pressure_after_global &&
+              early.feedback_probes[1].history_pressure_before == first.history_pressure_after_regional,
+          "one bounded straight physical assessment must feed its diagnosis into the next epoch");
+}
