+std::vector<std::vector<Point>> octilinear_connector_candidates(Point start, Point end) {
+  if (start == end) return {};
+  const auto dx = end.x.value() - start.x.value();
+  const auto dy = end.y.value() - start.y.value();
+  const auto diagonal = std::min(std::abs(dx), std::abs(dy));
+  const auto sx = dx < 0 ? -diagonal : diagonal;
+  const auto sy = dy < 0 ? -diagonal : diagonal;
+  const std::array<Point, 4> elbows{
+      Point{Nanometres{start.x.value() + sx}, Nanometres{start.y.value() + sy}},
+      Point{Nanometres{end.x.value() - sx}, Nanometres{end.y.value() - sy}},
+      Point{end.x, start.y}, Point{start.x, end.y}};
+  std::vector<std::vector<Point>> result;
+  for (const auto elbow : elbows) {
+    std::vector<Point> path{start};
+    if (elbow != start && elbow != end) path.push_back(elbow);
+    path.push_back(end);
+    if (std::find(result.begin(), result.end(), path) == result.end())
+      result.push_back(std::move(path));
+  }
+  return result;
+}
 
