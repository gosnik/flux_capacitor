+    const auto globally_negotiated = [](const GlobalRouteResult& global) {
+      return coarse_topology_complete(global) && global.sampled_overflow == 0U &&
+             global.corridor_overflow == 0U &&
+             global.unaccepted_selected_voronoi_lane_transitions == 0U;
+    };
+    const bool may_assess_nonfinal_straight =
+        full_strength_epoch && !config.curved_tracks && config.interleave_routability_feedback &&
+        !final_epoch && !nonfinal_full_straight_assessment_attempted;
+    bool nonfinal_full_straight_assessment = false;
+    if (may_assess_nonfinal_straight) {
+      std::optional<std::pair<GlobalRouteResult, bool>> selected_input;
+      if (globally_negotiated(probed_global) && probed_global.total_overflow == 0U) {
+        selected_input.emplace(probed_global, pass > 0U);
+      } else {
+        for (const auto& retained : retained_global_portfolios) {
+          if (globally_negotiated(retained) && retained.total_overflow == 0U) {
+            selected_input.emplace(retained, pass > 0U);
+            break;
+          }
+        }
+      }
+      if (selected_input) {
+        regional_inputs.clear();
+        regional_inputs.push_back(std::move(*selected_input));
+        nonfinal_full_straight_assessment = true;
+        nonfinal_full_straight_assessment_attempted = true;
+      }
+    }
