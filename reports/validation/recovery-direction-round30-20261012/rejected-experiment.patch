 }
 
+void constrained_endpoint_reverse_search_preserves_request_orientation() {
+  const auto make_board = [](bool sealed) {
+    auto board = fixture();
+    board.layers.resize(1U);
+    board.tracks.push_back({ObjectId{"constrained-source-component"}, NetId{"a"}, LayerId{"F.Cu"},
+                            mm(2,2), mm(2,18), Nanometres::from_mm(0.2), false});
+    board.tracks.push_back({ObjectId{"constrained-barrier"}, NetId{"b"}, LayerId{"F.Cu"},
+                            mm(10, sealed ? 0 : 5), mm(10, sealed ? 20 : 15),
+                            Nanometres::from_mm(0.8), false});
+    return board;
+  };
+  auto demand = request(NetId{"a"}, mm(2,10), LayerId{"F.Cu"}, mm(18,10), LayerId{"F.Cu"});
+  demand.connection_index = 7U;
+  CopperScaffoldConfig config;
+  config.grid_pitch = Nanometres::from_mm(0.5);
+  config.maximum_expansions_per_connection = 100'000U;
+  config.maximum_victim_exchanges = 0U;
+  config.maximum_joint_passage_candidates = 0U;
+  config.maximum_displacement_attempts = 0U;
+  config.compact_search_expansions = 50U;
+
+  auto compact_config = config;
+  compact_config.compact_search_expansions = 10'000U;
+  const auto compact_forward = construct_copper_scaffold(make_board(false), {demand}, compact_config);
+  auto compact_disabled = compact_config;
+  compact_disabled.constrained_endpoint_reverse_search = false;
+  const auto compact_reference = construct_copper_scaffold(make_board(false), {demand}, compact_disabled);
+  require(compact_forward.complete && compact_reference.complete &&
+              compact_forward.counters.constrained_endpoint_reversals == 0U &&
+              compact_forward.paths == compact_reference.paths &&
+              check_copper_rules(compact_forward.copper).ok(),
+          "a successful forward compact search must remain unchanged when reverse fallback is enabled");
+
+  const auto blocked = construct_copper_scaffold(make_board(true), {demand}, config);
+  require(!blocked.complete && blocked.paths.empty() &&
+              blocked.counters.compact_search_expansions == config.compact_search_expansions &&
+              blocked.counters.constrained_endpoint_reversals == 1U &&
+              blocked.request_evidence.size() == 1U &&
+              blocked.request_evidence.front().source_legal_attachments >
+                  blocked.request_evidence.front().target_legal_attachments &&
+              std::find(blocked.request_evidence.front().blocker_objects.begin(),
+                        blocked.request_evidence.front().blocker_objects.end(),
+                        ObjectId{"constrained-barrier"}) != blocked.request_evidence.front().blocker_objects.end(),
+          "a bounded asymmetric blocked search must reverse its frontier while retaining original blocker evidence");
+
+  const auto routed = construct_copper_scaffold(make_board(false), {demand}, config);
+  require(routed.complete && routed.counters.constrained_endpoint_reversals == 1U &&
+              routed.request_evidence.front().source_legal_attachments >
+                  routed.request_evidence.front().target_legal_attachments &&
+              routed.paths.front().points.front().position.x < routed.paths.front().points.back().position.x &&
+              routed.paths.front().net == demand.net &&
+              routed.paths.front().connection_index == demand.connection_index &&
+              check_copper_rules(routed.copper).ok(),
+          "reverse frontier search must publish a DRC-clean path in original request orientation");
+
+  auto rich_only = config;
+  rich_only.compact_search_expansions = 0U;
+  rich_only.maximum_expansions_per_connection = 100'000U;
+  const auto rich = construct_copper_scaffold(make_board(false), {demand}, rich_only);
+  require(rich.complete && rich.counters.constrained_endpoint_reversals == 1U &&
+              rich.paths.front().net == demand.net &&
+              rich.paths.front().connection_index == demand.connection_index &&
+              rich.paths.front().points.front().position.x < rich.paths.front().points.back().position.x &&
+              rich.counters.expansions <= rich_only.maximum_expansions_per_connection &&
+              check_copper_rules(rich.copper).ok(),
+          ("rich-only reverse search must retain original request identity, orientation, and budget: complete=" +
+           std::to_string(rich.complete) + " reversals=" + std::to_string(rich.counters.constrained_endpoint_reversals) +
+           " expansions=" + std::to_string(rich.counters.expansions) +
+           " source=" + std::to_string(rich.request_evidence.front().source_legal_attachments) +
+           " target=" + std::to_string(rich.request_evidence.front().target_legal_attachments) +
+           " termination=" + std::string(to_string(rich.request_evidence.front().termination))).c_str());
+
+  auto progressive = config;
+  progressive.progressive_attachment_search = true;
+  progressive.initial_attachment_states = 1U;
+  progressive.expanded_attachment_states = 32U;
+  progressive.maximum_attachment_states = 128U;
+  progressive.compact_search_expansions = 4'096U;
+  const auto widened = construct_copper_scaffold(make_board(true), {demand}, progressive);
+  require(!widened.complete && widened.counters.constrained_endpoint_reversals == 1U &&
+              widened.request_evidence.front().source_legal_attachments >
+                  widened.request_evidence.front().target_legal_attachments &&
+              widened.counters.source_attachments >= widened.request_evidence.front().source_legal_attachments &&
+              widened.counters.target_attachments >= widened.request_evidence.front().target_legal_attachments,
+          "progressive widening must reorient a tied prefix while preserving original attachment evidence");
+
+  auto progressive_rich = progressive;
+  progressive_rich.compact_search_expansions = 0U;
+  progressive_rich.maximum_expansions_per_connection = rich_only.maximum_expansions_per_connection;
+  const auto widened_rich = construct_copper_scaffold(make_board(false), {demand}, progressive_rich);
+  require(widened_rich.complete && widened_rich.counters.constrained_endpoint_reversals == 1U &&
+              widened_rich.request_evidence.front().source_legal_attachments >
+                  widened_rich.request_evidence.front().target_legal_attachments &&
+              widened_rich.paths.front().net == demand.net &&
+              widened_rich.paths.front().connection_index == demand.connection_index &&
+              widened_rich.paths.front().points.front().position.x <
+                  widened_rich.paths.front().points.back().position.x &&
+              widened_rich.counters.expansions <= progressive_rich.maximum_expansions_per_connection &&
+              check_copper_rules(widened_rich.copper).ok(),
+          "rich progressive widening must reverse the later asymmetric frontier without changing request orientation");
+
+  std::stop_source stop;
+  stop.request_stop();
+  const auto cancelled = construct_copper_scaffold(make_board(false), {demand}, config, stop.get_token());
+  require(cancelled.counters.cancelled && cancelled.counters.constrained_endpoint_reversals == 0U &&
+              cancelled.paths.empty() && check_copper_rules(cancelled.copper).ok(),
+          "cancellation before attachment generation must not publish or reverse a partial search");
+}
+
