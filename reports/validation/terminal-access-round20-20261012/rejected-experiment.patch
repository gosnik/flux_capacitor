+void inaccessible_terminal_evidence_excludes_the_accessible_end() {
+  auto board = fixture();
+  board.layers.resize(1U);
+  board.tracks.push_back({ObjectId{"source-neighbour"}, NetId{"b"}, LayerId{"F.Cu"},
+                          mm(1.55,1.5), mm(1.55,2.5), Nanometres::from_mm(0.2), true});
+  board.tracks.push_back({ObjectId{"target-blocker"}, NetId{"b"}, LayerId{"F.Cu"},
+                          mm(17,18), mm(19,18), Nanometres::from_mm(0.2), true});
+  CopperScaffoldConfig config;
+  config.maximum_victim_exchanges = 0U;
+  config.maximum_coupled_exchange_attempts = 0U;
+  config.maximum_joint_passage_candidates = 0U;
+  config.maximum_displacement_attempts = 0U;
+  for (const bool reverse : {false, true}) {
+    auto demand = request(NetId{"a"}, mm(2,2), LayerId{"F.Cu"}, mm(18.05,18.05), LayerId{"F.Cu"});
+    if (reverse) std::reverse(demand.points.begin(), demand.points.end());
+    const auto result = construct_copper_scaffold(board, {demand}, config);
+    const auto& evidence = result.request_evidence.front();
+    require(!result.complete && evidence.termination == CopperScaffoldSearchTermination::attachment_exhausted &&
+                (reverse ? evidence.target_legal_attachments : evidence.source_legal_attachments) > 0U &&
+                (reverse ? evidence.source_legal_attachments : evidence.target_legal_attachments) == 0U,
+            "one endpoint must retain access while the opposite endpoint is blocked");
+    require(result.counters.irrelevant_attachment_blockers_pruned > 0U &&
+                evidence.blocker_objects == std::vector<ObjectId>{ObjectId{"target-blocker"}},
+            "successful-end rejected probes must not displace the inaccessible-end repair witnesses");
+  }
+}
