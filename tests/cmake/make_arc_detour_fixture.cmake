if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "INPUT and OUTPUT are required")
endif()

if(DEFINED CANDIDATE)
  file(REMOVE "${CANDIDATE}")
endif()
if(DEFINED DRC_REPORT)
  file(REMOVE "${DRC_REPORT}")
endif()

file(READ "${INPUT}" contents)

set(original_net [=[  (net 0 "")
  (net 1 "SIGNAL")]=])
set(detour_nets [=[  (net 0 "")
  (net 1 "SIGNAL")
  (net 2 "BLOCKER")]=])
string(REPLACE "${original_net}" "${detour_nets}" contents "${contents}")

set(original_track [=[  (segment
    (start 20 40)
    (end 80 40)
    (width 0.25)
    (layer "F.Cu")
    (net 1)
    (uuid "33333333-3333-4333-8333-333333333333")
  )
]=])
string(REPLACE "${original_track}" "" contents "${contents}")

set(blockers [=[  (segment
    (start 50 25)
    (end 50 55)
    (width 0.25)
    (layer "F.Cu")
    (locked)
    (net 2)
    (uuid "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1")
  )
  (segment
    (start 50 25)
    (end 50 55)
    (width 0.25)
    (layer "B.Cu")
    (locked)
    (net 2)
    (uuid "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa2")
  )
  (via
    (at 50 25)
    (size 0.8)
    (drill 0.4)
    (layers "F.Cu" "B.Cu")
    (locked)
    (net 2)
    (uuid "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa3")
  )
  (via
    (at 50 55)
    (size 0.8)
    (drill 0.4)
    (layers "F.Cu" "B.Cu")
    (locked)
    (net 2)
    (uuid "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa4")
  )
]=])
string(FIND "${contents}" "  (gr_rect" insertion_offset)
if(insertion_offset EQUAL -1)
  message(FATAL_ERROR "fixture insertion point was not found")
endif()
string(SUBSTRING "${contents}" 0 ${insertion_offset} prefix)
string(SUBSTRING "${contents}" ${insertion_offset} -1 suffix)
file(WRITE "${OUTPUT}" "${prefix}${blockers}${suffix}")
