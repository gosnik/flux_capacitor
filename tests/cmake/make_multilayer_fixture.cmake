foreach(REQUIRED_VARIABLE INPUT OUTPUT CANDIDATE DRC_REPORT)
  if(NOT DEFINED ${REQUIRED_VARIABLE})
    message(FATAL_ERROR "${REQUIRED_VARIABLE} is required")
  endif()
endforeach()

file(READ "${INPUT}" BOARD_TEXT)
set(ORIGINAL_PAD [=[    (pad "1" smd circle
      (at 0 0)
      (size 2 2)
      (layers "F.Cu" "F.Paste" "F.Mask")
      (net 1 "SIGNAL")
      (uuid "22222222-2222-4222-8222-222222222225")
    )]=])
set(BACK_PAD [=[    (pad "1" smd circle
      (at 0 0)
      (size 2 2)
      (layers "B.Cu" "B.Paste" "B.Mask")
      (net 1 "SIGNAL")
      (uuid "22222222-2222-4222-8222-222222222225")
    )]=])
string(FIND "${BOARD_TEXT}" "${ORIGINAL_PAD}" PAD_POSITION)
if(PAD_POSITION EQUAL -1)
  message(FATAL_ERROR "second fixture pad block was not found")
endif()
string(REPLACE "${ORIGINAL_PAD}" "${BACK_PAD}" BOARD_TEXT "${BOARD_TEXT}")
file(WRITE "${OUTPUT}" "${BOARD_TEXT}")
file(REMOVE "${CANDIDATE}" "${DRC_REPORT}")
